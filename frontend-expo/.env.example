# Copy to `.env` in this folder (gitignored).
# Mirror these in Expo → Environment variables → production for `eas build`
# (values are inlined at bundle time).

EXPO_PUBLIC_API_URL=https://indextrading-production.up.railway.app

# Web-only: wide layouts redirect to the Next/desktop site (see app/_layout.tsx).
EXPO_PUBLIC_DESKTOP_URL=https://indextrading-one.vercel.app/
