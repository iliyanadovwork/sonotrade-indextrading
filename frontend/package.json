{
  "name": "sonotrade",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "//browserslist": "Modern target \u2014 drops core-js polyfills Next was injecting for Array.at/flat/flatMap, Object.fromEntries/hasOwn, String.trimStart/End, Math.trunc (PSI 'Legacy JavaScript'). Object.hasOwn is the binding constraint: Safari 15.4 / Chrome 93 (early 2022). Still supports every browser from ~2022 onward.",
  "browserslist": [
    "chrome >= 93",
    "edge >= 93",
    "firefox >= 92",
    "safari >= 15.4",
    "ios_saf >= 15.4"
  ],
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test"
  },
  "dependencies": {
    "@giphy/js-fetch-api": "^5.8.0",
    "@number-flow/react": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "dom-to-image-more": "^3.10.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "next": "^16.2.2",
    "posthog-js": "^1.376.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.12.3",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
