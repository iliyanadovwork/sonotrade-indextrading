# =====================================================================
# Sonotrade — frontend environment variables
#
# Regenerated from an actual grep of `process.env.*` across app/, lib/ and
# components/. Every var the code reads is listed here; vars for the
# retired Solana-custody / Inngest / Turnstile features have been removed
# because documenting non-existent config sends reviewers down the wrong
# threat model.
#
# Copy to .env.local for development. Never commit a filled-in copy.
#
# DEPLOYERS: on AWS Amplify a var must ALSO appear in the grep allowlist in
# amplify.yml, or it is simply `undefined` at runtime with no error. That is
# how JWT_SECRET and REDIS_URL came to be absent in production, which
# silently disabled all rate limiting and made every route fall back to a
# signing secret that is committed to this repo.
# =====================================================================

# ---------------------------------------------------------------------
# REQUIRED — the app fails closed without these
# ---------------------------------------------------------------------

# Supabase project. The URL and publishable key are public by design (they
# are inlined into the browser bundle) — which is precisely why Row Level
# Security has to be on. See sql/20260804_hardening_part3_rls.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias, still read as a fallback by lib/supabase/env.ts:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely — never expose to the browser, never
# commit. Rotate immediately if it ever lands in a repo, log, or ticket.
SUPABASE_SERVICE_ROLE_KEY=

# Signs and verifies the session JWT. MUST be at least 32 characters:
# lib/auth.ts throws at import time otherwise, deliberately, because a
# default value here would let anyone forge a token for any user.
#   Generate with: openssl rand -base64 48
JWT_SECRET=

# ---------------------------------------------------------------------
# REQUIRED FOR WRITES — rate limiting and locking now fail CLOSED
# ---------------------------------------------------------------------
# With REDIS_URL unset, rateLimit() denies and acquireLock() refuses, so
# login, signup, OTP, order placement and closes return 429/409 instead of
# running unlimited. Trade *correctness* does not depend on Redis (the
# Postgres advisory lock inside place_order_tx / close_position_tx covers
# that) but abuse protection does.
REDIS_URL=

# ---------------------------------------------------------------------
# EMAIL (OTP + verification)
# ---------------------------------------------------------------------
# A key prefixed `re_dev_` short-circuits to log-only, so local development
# never sends real mail.
RESEND_API_KEY=re_dev_PLACEHOLDER
FROM_EMAIL=noreply@sonotrade.io

# ---------------------------------------------------------------------
# ARTIST DATA ENRICHMENT
# ---------------------------------------------------------------------
# Spotify Web API app credentials (artist metadata, images, releases).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apify — exact monthly-listener counts. BILLED PER RUN (~$0.005/artist),
# which is why /api/artists/refresh requires auth, a rate limit, and a lock.
APIFY_TOKEN=
APIFY_ACTOR=

# ---------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------
# Canonical origin. Used for server-side self-fetches and sitemap URLs;
# required on Amplify SSR, where the Lambda origin otherwise resolves to
# localhost.
APP_BASE_URL=http://localhost:3000

# Homepage news feed (newsdata.io). Unset = the section renders empty.
NEWSDATA_API_KEY=

# Product analytics. Unset = PostHog no-ops cleanly.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=/ingest

# Only read by the retired backend-proxy path in admin tooling. Leave unset.
NEXT_PUBLIC_BACKEND_URL=
